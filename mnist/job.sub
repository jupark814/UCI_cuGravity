#!/bin/bash
#SBATCH --job-name="cu_mnist_manual"
#SBATCH -A givargis_lab_gpu

#SBATCH --partition=gpu
#SBATCH --gres=gpu:V100:1
#SBATCH --error=%x.err
#SBATCH --out=%x.out

hn='hostname'
echo "Running job on host $hn"

echo "=== CPU Information ==="
lscpu
echo ""

echo ""
echo "=== GPU Information ==="
nvidia-smi

echo -e "\n"

# Environment Setup
module load cuda/11.7.1
module load gcc/8.4.0

echo -e "=== Running mnist_manual ==="

make clean && make

# Start logging GPU usage in the background
echo "Timestamp, PID, Process, Memory Usage" > gpu_usage.log
while true; do
    echo "$(date +%T), $(nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv | tail -n +2)" >> gpu_usage.log
    sleep 5  # Log every 5 seconds
done &

# Store the process ID (PID) of the logging script
LOGGER_PID=$!

./cu_mnist_manual
kill $LOGGER_PID

echo ""

echo "Final GPU Status:" >> gpu_usage.log
nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv >> gpu_usage.log

echo -e "\n"

echo "=== Job Completed ==="


